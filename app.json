{
  "expo": {
    "name": "SpotCrime+",
    "slug": "spotcrime-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/police-icon.png",
    "scheme": "spotcrime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotCrime+ needs your location to report crimes and track emergencies."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a2a3a",
        "foregroundImage": "./assets/images/police-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.spotcrimeplus"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
"backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/police-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba1d3b72-6784-45d7-a0d9-cf1db7e4eb8c"
      }
    },
    "owner": "joeboy606"
  }
}
